<Bindings>
	<Binding name="KEIJINUI_MARK1" header="KEIJINUI">
		if KeijinUI.ModuleOn("shortcuts") then KeijinUI.marks.Set("target", 1) end;
	</Binding>
	<Binding name="KEIJINUI_MARK2">
		if KeijinUI.ModuleOn("shortcuts") then KeijinUI.marks.Set("target", 2) end;
	</Binding>
	<Binding name="KEIJINUI_MARK3">
		if KeijinUI.ModuleOn("shortcuts") then KeijinUI.marks.Set("target", 3) end;
	</Binding>
	<Binding name="KEIJINUI_MARK4">
		if KeijinUI.ModuleOn("shortcuts") then KeijinUI.marks.Set("target", 4) end;
	</Binding>
	<Binding name="KEIJINUI_MARK5">
		if KeijinUI.ModuleOn("shortcuts") then KeijinUI.marks.Set("target", 5) end;
	</Binding>
	<Binding name="KEIJINUI_MARK6">
		if KeijinUI.ModuleOn("shortcuts") then KeijinUI.marks.Set("target", 6) end;
	</Binding>
	<Binding name="KEIJINUI_MARK7">
		if KeijinUI.ModuleOn("shortcuts") then KeijinUI.marks.Set("target", 7) end;
	</Binding>
	<Binding name="KEIJINUI_MARK8">
		if KeijinUI.ModuleOn("shortcuts") then KeijinUI.marks.Set("target", 8) end;
	</Binding>
	<Binding name="KEIJINUI_MARK0">
		if KeijinUI.ModuleOn("shortcuts") then KeijinUI.marks.Set("target", 0) end;
	</Binding>
	<Binding name="KEIJINUI_LAYOUT">
		KeijinUI.layout.Toggle();
	</Binding>
</Bindings>
